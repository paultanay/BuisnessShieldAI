# Copy this file to .env and fill in the values before running `docker compose up`.

# --- Database ---
# Used by the API container. When using the bundled Postgres service
# from docker-compose.yml, you only need to set the credentials below.
POSTGRES_USER=businessshield
POSTGRES_PASSWORD=change-me
POSTGRES_DB=businessshield

# --- Authentication (Clerk) ---
# BusinessShield uses Clerk for authentication. Create your own
# free Clerk application at https://dashboard.clerk.com and use its keys here.
CLERK_SECRET_KEY=sk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Sessions ---
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=
